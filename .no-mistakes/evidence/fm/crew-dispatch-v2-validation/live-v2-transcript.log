      "use": [{"id": "codex-terra-xhigh", "harness": "codex", "model": "gpt-5.6-terra", "effort": "xhigh", "model_class": "ordinary"}]
    }
  ],
  "default": [{"id": "codex-terra", "harness": "codex", "model": "gpt-5.6-terra", "model_class": "ordinary"}, {"id": "claude-sonnet", "harness": "claude", "model": "sonnet", "model_class": "ordinary"}]
}
